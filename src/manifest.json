{
  "manifest_version": 3,
  "name": "Screenshot & Customize",
  "version": "1.4.1",
  "description": "Capture screenshots, customize pages, and enjoy the Dark Forest new tab.",
  "chrome_url_overrides": { "newtab": "index.html" },
  "action": { "default_popup": "popup.html", "default_icon": { "128": "icon128.png" } },
  "icons": { "128": "icon128.png" },
  "background": { "service_worker": "src/background/index.ts", "type": "module" },
  "permissions": ["tabs", "storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/customize.ts", "src/content/fullpage.ts"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": [
        "src/content/youtube/styles.ts",
        "src/content/youtube/cinema.ts",
        "src/content/youtube/recommendations.ts"
      ],
      "run_at": "document_end"
    }
  ]
}

