{
  "manifest_version": 3,
  "name": "Screenshot & Customize",
  "version": "1.3.2",
  "description": "Capture screenshots and customize pages from the extension popup.",
  "action": { "default_popup": "popup.html", "default_icon": { "128": "icon128.png" } },
  "icons": { "128": "icon128.png" },
  "background": { "service_worker": "src/background.ts", "type": "module" },
  "permissions": ["tabs", "storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content_customize.ts", "src/content_fullpage.ts"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": [
        "src/content_youtube_styles.ts",
        "src/content_youtube_cinema.ts",
        "src/content_youtube_recommendations.ts"
      ],
      "run_at": "document_end"
    }
  ]
}

