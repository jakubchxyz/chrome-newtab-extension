{
  "manifest_version": 3,
  "version": "3.1.1",
  "name": "Dark Forest UI",
  "description": "Near-black Chrome tabs and toolbar to pair with Screenshot & Customize's Dark Forest new tab.",
  "theme": {
    "colors": {
      "frame": [18, 18, 18],
      "frame_inactive": [18, 18, 18],
      "frame_incognito": [18, 18, 18],
      "frame_incognito_inactive": [18, 18, 18],
      "background_tab": [18, 18, 18],
      "background_tab_inactive": [18, 18, 18],
      "background_tab_incognito": [18, 18, 18],
      "background_tab_incognito_inactive": [18, 18, 18],
      "toolbar": [18, 18, 18],
      "toolbar_text": [200, 200, 200],
      "toolbar_button_icon": [200, 200, 200],
      "tab_text": [220, 220, 220],
      "tab_background_text": [160, 160, 160],
      "tab_background_text_inactive": [140, 140, 140],
      "tab_background_text_incognito": [160, 160, 160],
      "tab_background_text_incognito_inactive": [140, 140, 140],
      "bookmark_text": [180, 180, 180],
      "ntp_background": [10, 10, 10],
